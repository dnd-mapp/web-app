{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "web-app",
  "description": "The D&D Mapp website and web application.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "D&D Mapp",
  "homepage": "https://github.com/dnd-mapp/web-app#readme",
  "bugs": {
    "url": "https://github.com/dnd-mapp/web-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/web-app.git"
  },
  "scripts": {
    "format": "prettier -w .",
    "format-check": "prettier -c .",
    "lint-md": "markdownlint-cli2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:commitlint",
    "@dnd-mapp/config-commitlint": "catalog:commitlint",
    "@dnd-mapp/config-markdown": "catalog:markdown",
    "@dnd-mapp/config-prettier": "catalog:prettier",
    "@types/node": "catalog:",
    "lefthook": "catalog:commitlint",
    "markdownlint-cli2": "catalog:markdown",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "typescript": "catalog:"
  }
}
