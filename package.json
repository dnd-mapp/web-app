{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "web-app",
  "version": "0.0.0",
  "private": true,
  "description": "The web frontend for D&D Mapp.",
  "homepage": "https://github.com/dnd-mapp/web-app#readme",
  "bugs": {
    "url": "https://github.com/dnd-mapp/web-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/web-app.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "format": "prettier -w .",
    "format-check": "prettier -c .",
    "lint-md": "markdownlint-cli2"
  },
  "dependencies": {
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/forms": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "@angular/router": "catalog:angular",
    "rxjs": "catalog:angular",
    "tslib": "catalog:angular"
  },
  "devDependencies": {
    "@angular/cli": "catalog:angular",
    "@angular/compiler-cli": "catalog:angular",
    "markdownlint-cli2": "catalog:markdownlint",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "typescript": "catalog:angular"
  },
  "engines": {
    "node": "^24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "error"
    }
  }
}
