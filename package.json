{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "web-app",
  "description": "The D&D Mapp website and web application.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "D&D Mapp",
  "homepage": "https://github.com/dnd-mapp/web-app#readme",
  "bugs": {
    "url": "https://github.com/dnd-mapp/web-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/web-app.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test-ci": "ng test -c ci",
    "typecheck": "tsc -b --noEmit",
    "lint-ts": "eslint",
    "format": "prettier -w .",
    "format-check": "prettier -c .",
    "lint-md": "markdownlint-cli2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@angular/cdk": "catalog:angular",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/forms": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "@angular/router": "catalog:angular",
    "rxjs": "catalog:angular",
    "tslib": "catalog:angular"
  },
  "devDependencies": {
    "@angular/build": "catalog:angular",
    "@angular/cli": "catalog:angular",
    "@angular/compiler-cli": "catalog:angular",
    "@commitlint/cli": "catalog:commitlint",
    "@dnd-mapp/config-commitlint": "catalog:commitlint",
    "@dnd-mapp/config-eslint": "catalog:eslint",
    "@dnd-mapp/config-markdown": "catalog:markdown",
    "@dnd-mapp/config-prettier": "catalog:prettier",
    "@dnd-mapp/config-typescript": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "angular-eslint": "catalog:eslint",
    "eslint": "catalog:eslint",
    "lefthook": "catalog:commitlint",
    "markdownlint-cli2": "catalog:markdown",
    "playwright": "catalog:vitest",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:eslint",
    "vitest": "catalog:vitest"
  }
}
