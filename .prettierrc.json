{
    "$schema": "https://www.schemastore.org/prettierrc.json",
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "angular"
            }
        },
        {
            "files": ["*.webmanifest"],
            "options": {
                "parser": "json"
            }
        },
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "singleQuote": false
            }
        }
    ],
    "plugins": ["prettier-plugin-organize-imports"],
    "quoteProps": "consistent",
    "singleQuote": true
}
