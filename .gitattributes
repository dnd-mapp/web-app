# Normalize line endings to LF for all text files, auto-detecting text vs binary
*		text=auto eol=lf

# Generated lockfile: keep it out of diffs and language statistics
pnpm-lock.yaml	-diff linguist-generated

# Binary assets (never touch line endings)
*.ico	binary
*.png	binary
*.jpg	binary
*.jpeg	binary
*.gif	binary
*.webp	binary
*.woff	binary
*.woff2	binary
*.ttf	binary
*.eot	binary
